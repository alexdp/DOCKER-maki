[Unit]
Description=Apply hostname and network configuration from /run/config.env
After=load-usb-config.service
Before=network-pre.target
Requires=load-usb-config.service
ConditionPathExists=/run/config.env

[Service]
Type=oneshot
ExecStart=/usr/local/bin/load-network-config.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
